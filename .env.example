# ClassAudio Environment Variables Example
# 复制此文件为 .env 并填写实际值

# ==== LLM API Keys ====

# DeepSeek V4 Flash 配置（关键词、课堂笔记整理与问答共用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ==== 本地 ASR（可选）====
# 默认英文；中英文课堂可改为 multilingual，并把语言设为 auto
CLASSAUDIO_ASR_MODEL=en
CLASSAUDIO_ASR_LANGUAGE=en-US
CLASSAUDIO_ASR_DEVICE=cuda
CLASSAUDIO_HOTWORD_BOOST=3.0

# ==== 注意事项 ====
# 1. 将此文件复制为 .env: cp .env.example .env
# 2. 填写你的真实 API keys
# 3. .env 文件已被 .gitignore 忽略，不会被提交到 git
# 4. 也可以通过系统环境变量设置配置
